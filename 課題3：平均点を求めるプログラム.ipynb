     "text": [
      "5人のテストの平均点は80.0点です\n"
     ]
    }
   ],
   "source": [
    "total = 0\n",
    "count = 0\n",
    "\n",
    "while True:\n",
    "    score = int(input(\"点数を入力してください（-1で終了）：\"))\n",
    "    if score == -1:\n",
    "        break\n",
    "    total += score\n",
    "    count += 1\n",
    "\n",
    "if count > 0:\n",
    "    avg = round(total / count, 1)\n",
    "    print(f\"{count}人のテストの平均点は{avg}点です\")\n",
    "\n"
   ]
  }
 ],
